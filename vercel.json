{
  "services": {
    "web": {
      "root": "client",
      "framework": "nextjs"
    },
    "api": {
      "root": "server",
      "entrypoint": "src/app.ts",
      "buildCommand": "echo 'TypeScript is compiled by Vercel from src/app.ts'"
    }
  },
  "rewrites": [
    {
      "source": "/v1/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
